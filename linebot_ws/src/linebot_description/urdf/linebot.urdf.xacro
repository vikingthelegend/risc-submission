<?xml version="1.0"?>
<!--
  Reference line follower bot: differential drive, two frictionless casters,
  camera on a short mast looking forward-down at the floor.
  base_link sits at the wheel axle (wheel_r above the ground), x forward.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="linebot">

  <!-- ===================== tunable geometry ===================== -->
  <xacro:property name="chassis_l"    value="0.20"/>
  <xacro:property name="chassis_w"    value="0.12"/>
  <xacro:property name="chassis_h"    value="0.04"/>
  <xacro:property name="chassis_mass" value="1.0"/>
  <xacro:property name="chassis_oz"   value="0.015"/>   <!-- chassis centre above axle -->

  <xacro:property name="wheel_r"    value="0.035"/>
  <xacro:property name="wheel_w"    value="0.02"/>
  <xacro:property name="wheel_mass" value="0.1"/>
  <xacro:property name="wheel_y"    value="0.07"/>       <!-- half the wheel separation -->

  <xacro:property name="caster_r"    value="0.015"/>
  <xacro:property name="caster_x"    value="0.08"/>
  <xacro:property name="caster_mass" value="0.05"/>

  <!-- camera: 0.12 m ahead of axle, 0.12 m above it, pitched 0.9 rad (~52 deg) down.
       With a 1.2 rad HFOV this sees the floor ~0.15 m to ~0.45 m ahead of the axle. -->
  <xacro:property name="cam_x"     value="0.12"/>
  <xacro:property name="cam_z"     value="0.12"/>
  <xacro:property name="cam_pitch" value="0.9"/>

  <!-- ===================== materials ===================== -->
  <material name="chassis_blue"><color rgba="0.10 0.30 0.80 1"/></material>
  <material name="wheel_grey">  <color rgba="0.20 0.20 0.20 1"/></material>
  <material name="cam_orange">  <color rgba="0.95 0.50 0.10 1"/></material>

  <!-- ===================== inertia helpers ===================== -->
  <xacro:macro name="box_inertial" params="m x y z oz:=0">
    <inertial>
      <origin xyz="0 0 ${oz}" rpy="0 0 0"/>
      <mass value="${m}"/>
      <inertia ixx="${m*(y*y+z*z)/12}" ixy="0" ixz="0"
               iyy="${m*(x*x+z*z)/12}" iyz="0" izz="${m*(x*x+y*y)/12}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertial" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(3*r*r+h*h)/12}" ixy="0" ixz="0"
               iyy="${m*(3*r*r+h*h)/12}" iyz="0" izz="${m*r*r/2}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="sphere_inertial" params="m r">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${2*m*r*r/5}" ixy="0" ixz="0" iyy="${2*m*r*r/5}" iyz="0" izz="${2*m*r*r/5}"/>
    </inertial>
  </xacro:macro>

  <!-- ===================== base ===================== -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${chassis_oz}"/>
      <geometry><box size="${chassis_l} ${chassis_w} ${chassis_h}"/></geometry>
      <material name="chassis_blue"/>
    </visual>
    <!-- camera mast (visual only) -->
    <visual>
      <origin xyz="${cam_x - 0.015} 0 0.075"/>
      <geometry><box size="0.015 0.03 0.09"/></geometry>
      <material name="wheel_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${chassis_oz}"/>
      <geometry><box size="${chassis_l} ${chassis_w} ${chassis_h}"/></geometry>
    </collision>
    <xacro:box_inertial m="${chassis_mass}" x="${chassis_l}" y="${chassis_w}" z="${chassis_h}" oz="${chassis_oz}"/>
  </link>

  <!-- ===================== wheels ===================== -->
  <!-- joint frame rotated so the link z-axis points to +y; positive rotation = forward -->
  <xacro:macro name="wheel" params="name y">
    <link name="${name}_wheel">
      <visual>
        <geometry><cylinder radius="${wheel_r}" length="${wheel_w}"/></geometry>
        <material name="wheel_grey"/>
      </visual>
      <collision>
        <geometry><cylinder radius="${wheel_r}" length="${wheel_w}"/></geometry>
      </collision>
      <xacro:cylinder_inertial m="${wheel_mass}" r="${wheel_r}" h="${wheel_w}"/>
    </link>
    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_wheel"/>
      <origin xyz="0 ${y} 0" rpy="${-pi/2} 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>
    <gazebo reference="${name}_wheel">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:wheel name="left"  y="${wheel_y}"/>
  <xacro:wheel name="right" y="${-wheel_y}"/>

  <!-- ===================== casters (frictionless balls) ===================== -->
  <xacro:macro name="caster" params="name x">
    <link name="${name}_caster">
      <visual>
        <geometry><sphere radius="${caster_r}"/></geometry>
        <material name="wheel_grey"/>
      </visual>
      <collision>
        <geometry><sphere radius="${caster_r}"/></geometry>
      </collision>
      <xacro:sphere_inertial m="${caster_mass}" r="${caster_r}"/>
    </link>
    <joint name="${name}_caster_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${name}_caster"/>
      <origin xyz="${x} 0 ${caster_r - wheel_r}"/>
    </joint>
    <gazebo reference="${name}_caster">
      <mu1>0.0</mu1>
      <mu2>0.0</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:caster name="front" x="${caster_x}"/>
  <xacro:caster name="rear"  x="${-caster_x}"/>

  <!-- ===================== camera ===================== -->
  <link name="camera_link">
    <visual>
      <geometry><box size="0.02 0.04 0.02"/></geometry>
      <material name="cam_orange"/>
    </visual>
    <xacro:box_inertial m="0.02" x="0.02" y="0.04" z="0.02"/>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${cam_x} 0 ${cam_z}" rpy="0 ${cam_pitch} 0"/>
  </joint>

  <!-- ROS optical convention: z forward, x right, y down -->
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

  <!-- ===================== Gazebo plugins + camera sensor ===================== -->
  <xacro:include filename="$(find linebot_description)/urdf/linebot_gz.xacro"/>
  <xacro:linebot_gz left_joint="left_wheel_joint"
                    right_joint="right_wheel_joint"
                    wheel_separation="${2*wheel_y}"
                    wheel_radius="${wheel_r}"
                    camera_link="camera_link"/>
</robot>
